{
  "name": "ezbid-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -r ../polyfill.js node_modules/vite/bin/vite.js",
    "build": "node build.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node -r ../polyfill.js node_modules/vitest/vitest.mjs run",
    "test:coverage": "node -r ../polyfill.js node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "ezbid-root": "file:..",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.1.0",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
